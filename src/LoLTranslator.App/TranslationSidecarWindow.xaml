<Window x:Class="LoLTranslator.App.TranslationSidecarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="330" Height="250" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize">
  <Border x:Name="RootBorder" Background="#55101827" CornerRadius="6" Padding="8">
    <StackPanel>
      <Border x:Name="DragHandle" Visibility="Collapsed" Background="#AA26354A" CornerRadius="4" Padding="6" Cursor="SizeAll" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
        <TextBlock Text="拖动移动译文区域" Foreground="#D1FAE5" FontSize="12"/>
      </Border>
      <ItemsControl x:Name="TranslationItems">
        <ItemsControl.ItemTemplate>
          <DataTemplate><ContentPresenter Content="{Binding}"/></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
