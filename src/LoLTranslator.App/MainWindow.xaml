<Window x:Class="LoLTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoLTranslator.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LoL Translator"
        Width="560"
        Height="460"
        MinWidth="500"
        MinHeight="410"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#111827">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E5EDF8"/>
            <Setter Property="Background" Value="#263449"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2878D0"/>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B9C7DA"/>
            <Setter Property="Background" Value="#1A2535"/>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#9EABC0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E5EDF8"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Background="#111827"
            BorderBrush="#2A3548"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0D1421"
                    CornerRadius="11,11,0,0"
                    BorderBrush="#222D3E"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="28" Height="28"
                            VerticalAlignment="Center"
                            Background="#2878D0"
                            CornerRadius="7">
                        <TextBlock Text="L"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="LoL Translator"
                                   Foreground="#F3F6FB"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <Border Margin="9,0,0,0"
                                Padding="7,2"
                                Background="#1A2535"
                                CornerRadius="9">
                            <TextBlock Text="Preview"
                                       Foreground="#8290A6"
                                       FontSize="10"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButton}"
                                Content="−"
                                ToolTip="最小化"
                                Click="MinimizeWindowButton_Click"/>
                        <Button Style="{StaticResource WindowButton}"
                                Content="×"
                                ToolTip="关闭"
                                Click="CloseWindowButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

    <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="LoL Translator"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1"
                   Margin="0,4,0,16"
                   Text="{x:Static local:RuntimeBuildInfo.Label}"
                   Foreground="#9CA3AF"
                   FontSize="15"/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <Border Background="#1F2937"
                    CornerRadius="10"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 当前状态 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="当前状态"
                                   Foreground="#9CA3AF"
                                   FontSize="13"/>

                        <TextBlock x:Name="StatusText"
                                   Margin="0,6,0,0"
                                   Text="等待设置"
                                   Foreground="#FCD34D"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- 系统目标语言 -->
                    <Grid Grid.Row="1"
                          Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="165"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="翻译为"
                                       Foreground="White"
                                       FontSize="16"/>

                            <TextBlock Margin="0,4,0,0"
                                       Text="自动跟随 Windows 系统语言"
                                       Foreground="#9CA3AF"
                                       FontSize="13"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                MinHeight="38"
                                Padding="10,7"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="SystemLanguageText"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- 聊天框区域 -->
                    <Grid Grid.Row="2"
                          Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="165"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="聊天框区域"
                                       Foreground="White"
                                       FontSize="16"/>

                            <TextBlock x:Name="SelectedRegionText"
                                       Margin="0,4,0,0"
                                       Text="尚未选择聊天框区域"
                                       Foreground="#9CA3AF"
                                       FontSize="13"/>
                            <TextBlock x:Name="ContinuousStatusText"
                                       Margin="0,4,0,0"
                                       Text="选择聊天区域后会自动开始连续翻译。"
                                       Foreground="#A7F3D0"
                                       FontSize="12"/>
                            <TextBlock x:Name="CoverageStatusText"
                                       Margin="0,5,0,0"
                                       Text="画面覆盖率：等待消息样本"
                                       Foreground="#93C5FD"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       ToolTip="仅统计 OCR 至少读到时间戳的消息；完全未被 OCR 读到的行需用固定台词测试测量。"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Button x:Name="SelectRegionButton" Style="{StaticResource PrimaryButton}" Height="38" Content="选择聊天区域" FontSize="14" Click="SelectRegionButton_Click"/>
                            <Button x:Name="RestoreRegionButton" Visibility="Collapsed" Margin="0,6,0,0" Height="28" Content="使用上次聊天区域" IsEnabled="False" Click="RestoreRegionButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 测试截图 -->
                    <Grid Grid.Row="3"
                          Margin="0,22,0,10"
                          Visibility="Collapsed">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="截图预览"
                                       Foreground="White"
                                       FontSize="16"/>

                            <TextBlock x:Name="LastCaptureText"
                                       Margin="0,4,0,0"
                                       Text="尚未进行测试截图"
                                       Foreground="#9CA3AF"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button x:Name="TestCaptureButton"
                                Grid.Column="1"
                                Height="40"
                                Content="截取当前区域"
                                FontSize="14"
                                IsEnabled="False"
                                Click="TestCaptureButton_Click"/>
                    </Grid>

                    <!-- 截图预览 -->
                    <Border Grid.Row="4"
                            Visibility="Collapsed"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">

                        <Grid>
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="选择聊天区域后，点击“截取当前区域”"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Image x:Name="CapturePreviewImage"
                                   Stretch="Uniform"/>
                        </Grid>
                    </Border>

<!-- OCR 控制区域 -->
<Grid Grid.Row="5"
      Margin="0,22,0,10"
      Visibility="Collapsed">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="220"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0"
                Margin="0,0,20,0"
                VerticalAlignment="Center">

        <TextBlock Text="OCR 来源语言"
                   Foreground="White"
                   FontSize="16"/>

<ComboBox x:Name="SourceLanguageComboBox"
          Width="300"
          Height="36"
          Margin="0,7,0,0"
          HorizontalAlignment="Left"
          VerticalContentAlignment="Center"/>

        <TextBlock x:Name="OcrStatusText"
                   Margin="0,7,0,0"
                   Text="请先进行测试截图"
                   Foreground="#9CA3AF"
                   FontSize="13"/>
    </StackPanel>

    <Button x:Name="RecognizeButton"
            Grid.Column="1"
            Height="40"
            Content="识别截图文字"
            FontSize="14"
            IsEnabled="False"
            VerticalAlignment="Center"
            Click="RecognizeButton_Click"/>
</Grid>
                    <Grid Grid.Row="6" Margin="0,6,0,6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBlock Text="自动监测新消息" Foreground="#D1D5DB" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="画面变化后自动识别" Foreground="#9CA3AF" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <Expander Grid.Row="3" Margin="0,14,0,0" Header="诊断与调整" IsExpanded="False" Foreground="#9CA3AF">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="RuntimeTraceStatusText" Text="运行轨迹将在开始后自动记录。" Foreground="#A7F3D0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TracePathText" Margin="0,4,0,0" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="DockSidecarButton" Width="145" Height="30" Content="译文窗贴回聊天旁" IsEnabled="False" Click="DockSidecarButton_Click"/>
                                <Button x:Name="AdjustSidecarButton" Margin="8,0,0,0" Width="145" Height="30" Content="调整译文窗位置" IsEnabled="False" Click="AdjustSidecarButton_Click"/>
                                <Button Margin="8,0,0,0" Width="120" Height="30" Content="打开诊断文件夹" Click="OpenTraceFolderButton_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="手动截取区域" Width="145" Height="30" Click="TestCaptureButton_Click"/>
                                <Button Content="手动识别文字" Margin="8,0,0,0" Width="145" Height="30" Click="RecognizeButton_Click"/>
                            </WrapPanel>
                            <CheckBox x:Name="MinimizeAfterStartCheckBox" Margin="0,10,0,0" Content="连续翻译开始后最小化主窗口" IsChecked="False" Foreground="#D1D5DB"/>
                            <CheckBox x:Name="OcrTextDiagnosticCheckBox" Margin="0,8,0,0" Content="本次测试保存原始输入追踪（聊天区域截图、OCR 候选和译文；仅本机，可能包含玩家名）" IsChecked="False" Foreground="#FCD34D"/>
                            <TextBlock x:Name="OcrDiagnosticPathText" Margin="0,4,0,0" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                    <!-- Shadow 匹配上下文 -->
                    <Grid Grid.Row="7"
                          Margin="0,10,0,10"
                          Visibility="Collapsed">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,20,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Shadow 匹配上下文"
                                       Foreground="White"
                                       FontSize="16"/>

                            <TextBlock Text="正式 0.3.0 会严格检查社区和渠道"
                                       Margin="0,4,0,0"
                                       Foreground="#9CA3AF"
                                       FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">

                            <TextBlock Text="语义语言"
                                       Foreground="#D1D5DB"
                                       FontSize="12"/>

                            <ComboBox x:Name="SemanticLocaleComboBox"
                                      Height="36"
                                      Margin="0,4,0,0"
                                      DisplayMemberPath="DisplayName"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="社区/渠道"
                                       Foreground="#D1D5DB"
                                       FontSize="12"/>

                            <ComboBox x:Name="ShadowContextComboBox"
                                      Height="36"
                                      Margin="0,4,0,0"
                                      DisplayMemberPath="DisplayName"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- OCR 结果 -->
                    <TextBox x:Name="OcrResultTextBox"
                             Grid.Row="8"
                             Visibility="Collapsed"
                             Padding="12"
                             Background="#0F172A"
                             Foreground="White"
                             BorderBrush="#334155"
                             BorderThickness="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="识别结果会显示在这里。"/>

                    <!-- SlangGraph shadow 结果 -->
                    <StackPanel Grid.Row="9"
                                Margin="0,16,0,0"
                                Visibility="Collapsed">

                        <TextBlock Text="0.3.0 Shadow 语义结果"
                                   Foreground="White"
                                   FontSize="16"/>

                        <TextBlock x:Name="PackStatusText"
                                   Margin="0,4,0,8"
                                   Text="正在加载正式 Pack……"
                                   Foreground="#9CA3AF"
                                   FontSize="13"/>

                        <CheckBox x:Name="ChampionRc2ShadowCheckBox"
                                  Margin="0,0,0,4"
                                   Content="测试模式：启用 RC.2 官方英雄名保护、Qwen3 与候选 t0P 规范化 Shadow（默认关闭）"
                                  Foreground="#FCD34D"
                                   ToolTip="只用于本次截图测试；候选 t0P 规范化需要 LoL 局内聊天上下文和官方英雄名锚点。不发布、不设默认，也不加载玩家别名或 rotate。"/>

                        <TextBlock x:Name="ChampionRc2ShadowStatusText"
                                   Margin="0,0,0,8"
                                   Text="关闭时只运行现有正式 0.3.0 Shadow。启用后，可靠融合且命中官方英雄名的行才可调用本地 Qwen3；候选 t0P 仅作 typed lane.top Shadow 规范化。"
                                   Foreground="#9CA3AF"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="IncrementalGeneralShadowCheckBox"
                                  Margin="0,0,0,4"
                                  Content="测试模式：启用增量通用聊天 Qwen3 Shadow（默认关闭）"
                                  Foreground="#FCD34D"
                                  ToolTip="只翻译可靠融合的新增聊天正文；同一会话里已处理正文不会再次调用模型。不会保存原图、不会发布，也不会加载玩家别名或 rotate。"/>

                        <TextBlock x:Name="IncrementalGeneralShadowStatusText"
                                   Margin="0,0,0,8"
                                   Text="关闭时不运行增量通用聊天 Shadow。启用后仅对可靠的新正文调用本机 Qwen3；聊天前缀、融合歧义和不可靠边界不会送给模型。"
                                   Foreground="#9CA3AF"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="IncrementalGeneralSessionStateText"
                                   Margin="0,0,0,6"
                                   Text="尚未选择聊天区域。"
                                   Foreground="#A7F3D0"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <Button x:Name="ResetIncrementalGeneralSessionButton"
                                Margin="0,0,0,8"
                                Height="30"
                                HorizontalAlignment="Left"
                                Content="清空本次聊天去重记录"
                                IsEnabled="False"
                                ToolTip="仅在你准备重新开始同一区域的测试时使用；不会删除截图或数据。"
                                Click="ResetIncrementalGeneralSessionButton_Click"/>

                        <TextBox x:Name="ShadowResultTextBox"
                                 Height="220"
                                 Padding="12"
                                 Background="#0F172A"
                                 Foreground="White"
                                 BorderBrush="#334155"
                                 BorderThickness="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="识别截图后，这里会显示正式 Pack 的 shadow 匹配结果。"/>

                        <Button x:Name="SaveChampionRc2ShadowLogButton"
                                Margin="0,8,0,0"
                                Height="32"
                                HorizontalAlignment="Left"
                                Content="保存本地脱敏 RC.2 Shadow 日志"
                                IsEnabled="False"
                                ToolTip="仅保存必要的脱敏 OCR 文本、实体锁定、输出、时延和失败原因；不保存原图、不进入数据集。"
                                Click="SaveChampionRc2ShadowLogButton_Click"/>

                        <Button x:Name="SaveIncrementalGeneralShadowLogButton"
                                Margin="0,8,0,0"
                                Height="32"
                                HorizontalAlignment="Left"
                                Content="保存本地脱敏增量 Shadow 日志"
                                IsEnabled="False"
                                ToolTip="仅保存会话内摘要指纹、去重状态、路由、保护结果、输出与失败原因；不保存原图、路径或昵称。"
                                Click="SaveIncrementalGeneralShadowLogButton_Click"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="FeedbackKindComboBox"
                                      Grid.Column="0"
                                      Height="36"
                                      DisplayMemberPath="DisplayName"
                                      VerticalContentAlignment="Center"/>

                            <ComboBox x:Name="FeedbackOriginComboBox"
                                      Grid.Column="1"
                                      Height="36"
                                      Margin="10,0,0,0"
                                      DisplayMemberPath="DisplayName"
                                      ToolTip="必须明确标记为 synthetic fixture、controlled test 或 real source；未知来源不能保存。"
                                      VerticalContentAlignment="Center"/>

                            <TextBox x:Name="FeedbackNotesTextBox"
                                     Grid.Column="2"
                                     Height="36"
                                     Margin="10,0"
                                     Padding="8,6"
                                     Background="#0F172A"
                                     Foreground="White"
                                     BorderBrush="#334155"
                                     BorderThickness="1"
                                     ToolTip="可选备注；请勿填写玩家 ID 或其他可识别信息。"
                                     VerticalContentAlignment="Center"/>

                            <Button x:Name="SaveFeedbackButton"
                                    Grid.Column="3"
                                    Height="36"
                                    Content="保存运行反馈"
                                    IsEnabled="False"
                                    Click="SaveFeedbackButton_Click"/>
                        </Grid>

                        <TextBlock x:Name="FeedbackStatusText"
                                   Margin="0,6,0,0"
                                   Text="运行反馈仅在你点击保存后写入本机待脱敏收件箱。"
                                   Foreground="#9CA3AF"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <Button x:Name="PreflightFeedbackButton"
                                Margin="0,7,0,0"
                                Height="32"
                                HorizontalAlignment="Left"
                                Content="预检并导出本地清单"
                                Click="PreflightFeedbackButton_Click"/>
                    </StackPanel>

                    <!-- 隐私说明 -->
                    <Border Grid.Row="10"
                            Visibility="Collapsed"
                            Margin="0,14,0,0"
                            Padding="12"
                            CornerRadius="8"
                            Background="#111827">

                        <TextBlock Text="截图和 OCR 均在本机处理。RC.2/Qwen3 Shadow 只有勾选测试模式后才调用本机模型；原图不写入数据集，日志须由你主动保存且仅保留脱敏文本。"
                                   Foreground="#D1D5DB"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="StartButton"
                    Style="{StaticResource PrimaryButton}"
                    Width="165"
                    Height="38"
                    Margin="0,0,10,0"
                    Content="开始连续翻译"
                    FontSize="15"
                    Click="StartButton_Click"/>

            <Button x:Name="PauseButton"
                    Visibility="Collapsed"
                    Width="90" Height="38" Margin="0,0,10,0"
                    Content="暂停" FontSize="15" IsEnabled="False"
                    Click="PauseButton_Click"/>

            <Button x:Name="PlayerFeedbackButton"
                    Style="{StaticResource QuietButton}"
                    Width="90" Height="38"
                    Content="反馈问题" FontSize="14"
